# ==========================================
# LocalBite Platform Environment Template
# Copy this file to .env before running
# ==========================================

# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=localbite_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security (Must be at least 256 bits / 32 bytes hexadecimal)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Payment Gateway (Razorpay Sandbox/Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Server & CORS
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=ws://localhost:8080/api/ws
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
